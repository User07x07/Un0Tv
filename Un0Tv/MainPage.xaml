<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Un0Tv"
             x:Class="Un0Tv.MainPage"
             BackgroundColor="Black"
             Padding="0"
             Shell.NavBarIsVisible="False">

	<Grid>

		<!-- The site is only started once the home screen below has finished,
		     so nothing loads behind it. -->
		<WebView x:Name="Browser"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated" />

		<!-- ============================================================
		     Home: the protection dashboard.
		     Left: the shield, whether we are protected, and how many
		     lookups were blocked today.
		     Right: the protection layers, each with its own switch.
		     ============================================================ -->
		<Grid x:Name="HomePanel"
              IsVisible="False"
              BackgroundColor="#0D0D12"
              ColumnDefinitions="2*,3*"
              ColumnSpacing="52"
              Padding="52,40">

			<!-- Left column: status -->
			<VerticalStackLayout Grid.Column="0"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="4">

				<!-- The status badge. Green tick when everything is on,
				     red cross when the filter is off. -->
				<Border x:Name="ShieldRing"
                        WidthRequest="150"
                        HeightRequest="150"
                        BackgroundColor="#15151F"
                        StrokeThickness="3"
                        Stroke="#2C2C40"
                        HorizontalOptions="Center"
                        Margin="0,0,0,14">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="75" />
					</Border.StrokeShape>
					<Label x:Name="ShieldGlyph"
                           Text="&#x2713;"
                           FontSize="70"
                           TextColor="#4CD07D"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
				</Border>

				<Label x:Name="ShieldState"
                       Text="Protected"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

				<Label x:Name="LayerCount"
                       Text="3 of 3 layers on"
                       FontSize="17"
                       TextColor="#9A9AB2"
                       HorizontalTextAlignment="Center" />

				<!-- The day's figure, the way Repel shows it. -->
				<Label x:Name="BlockedToday"
                       Text="0"
                       FontSize="58"
                       FontAttributes="Bold"
                       TextColor="#8F80F5"
                       HorizontalTextAlignment="Center"
                       Margin="0,18,0,0" />

				<Label Text="blocked today"
                       FontSize="16"
                       TextColor="#9A9AB2"
                       HorizontalTextAlignment="Center" />

				<Label x:Name="ChecksToday"
                       Text="No lookups yet"
                       FontSize="14"
                       TextColor="#6C6C84"
                       HorizontalTextAlignment="Center" />
			</VerticalStackLayout>

			<!-- Right column: the layers -->
			<VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="14">

				<Label Text="Protection layers"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#C9C9DE" />

				<!-- Layer 1: the filter itself -->
				<Border BackgroundColor="#15151F"
                        Stroke="#26263A"
                        StrokeThickness="1"
                        Padding="20,16">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="16" />
					</Border.StrokeShape>

					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
						<Border Grid.Column="0"
                                BackgroundColor="#211E3A"
                                WidthRequest="46"
                                HeightRequest="46"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="23" />
							</Border.StrokeShape>
							<Label Text="A"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#8F80F5"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
						</Border>

						<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
							<Label Text="Ad and tracker filter"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="White" />
							<Label x:Name="LayerFilterInfo"
                                   Text="Filtering with the built-in rules"
                                   FontSize="14"
                                   TextColor="#8A8AA4" />
						</VerticalStackLayout>

						<Button x:Name="BtnFilter"
                                Grid.Column="2"
                                Text="ON"
                                Clicked="OnFilterToggled"
                                FontSize="17"
                                FontAttributes="Bold"
                                Padding="0"
                                WidthRequest="104"
                                HeightRequest="48"
                                CornerRadius="24"
                                VerticalOptions="Center" />
					</Grid>
				</Border>

				<!-- Layer 2: the big public block list -->
				<Border BackgroundColor="#15151F"
                        Stroke="#26263A"
                        StrokeThickness="1"
                        Padding="20,16">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="16" />
					</Border.StrokeShape>

					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
						<Border Grid.Column="0"
                                BackgroundColor="#162A22"
                                WidthRequest="46"
                                HeightRequest="46"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="23" />
							</Border.StrokeShape>
							<Label Text="H"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#4CD07D"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
						</Border>

						<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
							<Label Text="HaGeZi Multi PRO list"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="White" />
							<Label x:Name="LayerListInfo"
                                   Text="Not downloaded yet"
                                   FontSize="14"
                                   TextColor="#8A8AA4" />
						</VerticalStackLayout>

						<Button x:Name="BtnList"
                                Grid.Column="2"
                                Text="Get"
                                Clicked="OnListClicked"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="0"
                                WidthRequest="104"
                                HeightRequest="48"
                                CornerRadius="24"
                                VerticalOptions="Center" />
					</Grid>
				</Border>

				<!-- Layer 3: the TV's own Private DNS, which works even with
				     the app closed. -->
				<Border BackgroundColor="#15151F"
                        Stroke="#26263A"
                        StrokeThickness="1"
                        Padding="20,16">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="16" />
					</Border.StrokeShape>

					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
						<Border Grid.Column="0"
                                BackgroundColor="#1B2436"
                                WidthRequest="46"
                                HeightRequest="46"
                                VerticalOptions="Center">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="23" />
							</Border.StrokeShape>
							<Label Text="D"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#6BA8FF"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
						</Border>

						<VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
							<Label Text="Private DNS"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="White" />
							<Label x:Name="LayerDnsInfo"
                                   Text="Checked on this TV"
                                   FontSize="14"
                                   TextColor="#8A8AA4" />
						</VerticalStackLayout>

						<Button x:Name="BtnDns"
                                Grid.Column="2"
                                Text="Open"
                                Clicked="OnDnsPanelClicked"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="0"
                                WidthRequest="104"
                                HeightRequest="48"
                                CornerRadius="24"
                                VerticalOptions="Center" />
					</Grid>
				</Border>

				<ProgressBar x:Name="ListProgress"
                             IsVisible="False"
                             ProgressColor="#8F80F5"
                             HeightRequest="5"
                             Margin="0,4" />

				<Label x:Name="HomeHint"
                       Text="Arrows move, OK presses. Filtering starts with the site."
                       FontSize="14"
                       TextColor="#6C6C84" />

				<!-- The two things a viewer actually came to do. -->
				<HorizontalStackLayout Spacing="16" Margin="0,6,0,0">
					<Button x:Name="BtnActivity"
                            Text="Activity"
                            Clicked="OnActivityClicked"
                            BackgroundColor="#232334"
                            TextColor="#DCDCF0"
                            FontSize="18"
                            Padding="28,14"
                            CornerRadius="12" />

					<Button x:Name="BtnStart"
                            Text="Start watching"
                            Clicked="OnStartClicked"
                            BackgroundColor="#1F6FEB"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            Padding="28,14"
                            CornerRadius="12" />
				</HorizontalStackLayout>
			</VerticalStackLayout>
		</Grid>

		<!-- ============================================================
		     Activity: what was asked for, and whether it got through.
		     The same list Repel shows, limited to this app.
		     ============================================================ -->
		<Grid x:Name="ActivityPanel"
              IsVisible="False"
              BackgroundColor="#0D0D12"
              RowDefinitions="Auto,*"
              RowSpacing="18"
              Padding="52,38">

			<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
				<Button x:Name="BtnBack"
                        Grid.Column="0"
                        Text="&#x2190; Home"
                        Clicked="OnBackToHomeClicked"
                        BackgroundColor="#232334"
                        TextColor="#DCDCF0"
                        FontSize="17"
                        Padding="22,12"
                        CornerRadius="12" />

				<Label Grid.Column="1"
                       Text="Activity"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />

				<Button x:Name="BtnRowsFilter"
                        Grid.Column="2"
                        Text="All"
                        Clicked="OnRowsFilterClicked"
                        BackgroundColor="#232334"
                        TextColor="#DCDCF0"
                        FontSize="17"
                        Padding="22,12"
                        CornerRadius="12" />
			</Grid>

			<Label x:Name="ActivityEmpty"
                   Grid.Row="1"
                   Text="Nothing has been looked up yet. Start watching a movie and come back."
                   FontSize="19"
                   TextColor="#7A7A92"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center" />

			<CollectionView x:Name="ActivityList"
                            Grid.Row="1"
                            SelectionMode="None">

				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="local:LogEntry">

						<Border BackgroundColor="#15151F"
                                Stroke="#222234"
                                StrokeThickness="1"
                                Padding="18,12"
                                Margin="0,0,0,8">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="14" />
							</Border.StrokeShape>

							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

								<Border Grid.Column="0"
                                        BackgroundColor="{Binding BadgeBg}"
                                        WidthRequest="38"
                                        HeightRequest="38"
                                        VerticalOptions="Center">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="19" />
									</Border.StrokeShape>
									<Label Text="{Binding Badge}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{Binding BadgeColor}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
								</Border>

								<VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
									<Label Text="{Binding Host}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#EDEDF7" />
									<Label Text="{Binding Detail}"
                                           FontSize="13"
                                           TextColor="#7E7E96" />
								</VerticalStackLayout>

								<Label Grid.Column="2"
                                       Text="{Binding Kind}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{Binding BadgeColor}"
                                       VerticalOptions="Center" />
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</Grid>

		<!-- ============================================================
		     Private DNS presets: the list of DNS names to paste into the
		     TV's own Private DNS page, plus the whole-TV VPN filter.
		     ============================================================ -->
		<Grid x:Name="DnsPanel"
              IsVisible="False"
              BackgroundColor="#0D0D12"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="18"
              Padding="52,38">

			<Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="22">
				<Button x:Name="BtnDnsBack"
                        Grid.Column="0"
                        Text="&#x2190; Home"
                        Clicked="OnDnsBackClicked"
                        BackgroundColor="#232334"
                        TextColor="#DCDCF0"
                        FontSize="17"
                        Padding="22,12"
                        CornerRadius="12" />

				<Label Grid.Column="1"
                       Text="Private DNS presets"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
			</Grid>

			<Label x:Name="DnsPresetInfo"
                   Grid.Row="1"
                   Text=""
                   FontSize="16"
                   TextColor="#9A9AB2" />

			<ScrollView Grid.Row="2">
				<VerticalStackLayout x:Name="DnsPresetList" Spacing="10">

					<!-- The preset buttons are added here in code, above these two. -->
					<Button x:Name="BtnVpn"
                            Text="Filter every app on this TV (VPN)"
                            Clicked="OnVpnClicked"
                            BackgroundColor="#1F6FEB"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            Margin="0,14,0,0" />

					<Button x:Name="BtnOpenDns"
                            Text="Open the TV's Private DNS page"
                            Clicked="OnOpenDnsSettingsClicked"
                            BackgroundColor="#232334"
                            TextColor="#DCDCF0"
                            FontSize="17"
                            CornerRadius="12" />
				</VerticalStackLayout>
			</ScrollView>
		</Grid>
	</Grid>
</ContentPage>
