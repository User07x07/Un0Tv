<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Un0Tv.MainPage"
             BackgroundColor="Black"
             Padding="0"
             Shell.NavBarIsVisible="False">

	<Grid>

		<!-- The site is only started once the startup check below has finished,
		     so nothing loads behind the gate. -->
		<WebView x:Name="Browser"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated" />

		<!-- Startup check: the TV's ad filter should be installed and allowed to
		     run before the site opens. Shown until both are true, or until you
		     choose to carry on without it. -->
		<Grid x:Name="AdGate"
              IsVisible="False"
              BackgroundColor="#101014"
              Padding="56">

			<VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">

				<Label Text="Before Un0Tv starts"
                       FontSize="38"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

				<Label x:Name="GateStatus"
                       FontSize="21"
                       TextColor="#B8B8CC"
                       HorizontalTextAlignment="Center"
                       MaximumWidthRequest="900" />

				<HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="18"
                                       Margin="0,12,0,0">

					<Button x:Name="BtnInstall"
                            Text="Install ad filter"
                            Clicked="OnInstallClicked"
                            BackgroundColor="#1F6FEB"
                            TextColor="White"
                            FontSize="21"
                            Padding="30,16"
                            CornerRadius="10" />

					<Button x:Name="BtnAllow"
                            Text="Allow it to run"
                            Clicked="OnAllowClicked"
                            BackgroundColor="#1F6FEB"
                            TextColor="White"
                            FontSize="21"
                            Padding="30,16"
                            CornerRadius="10" />

					<Button x:Name="BtnRecheck"
                            Text="Check again"
                            Clicked="OnRecheckClicked"
                            BackgroundColor="#2A2A38"
                            TextColor="White"
                            FontSize="21"
                            Padding="30,16"
                            CornerRadius="10" />

					<Button x:Name="BtnSkip"
                            Text="Continue anyway"
                            Clicked="OnSkipClicked"
                            BackgroundColor="#2A2A38"
                            TextColor="#C8C8D8"
                            FontSize="21"
                            Padding="30,16"
                            CornerRadius="10" />

				</HorizontalStackLayout>

				<Label x:Name="GateHint"
                       FontSize="17"
                       TextColor="#7A7A90"
                       HorizontalTextAlignment="Center"
                       MaximumWidthRequest="900"
                       Margin="0,10,0,0" />

			</VerticalStackLayout>
		</Grid>
	</Grid>
</ContentPage>
