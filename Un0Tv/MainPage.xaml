<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Un0Tv.MainPage"
             BackgroundColor="Black"
             Padding="0"
             Shell.NavBarIsVisible="False">

	<Grid>

		<!-- The site is only started once the startup check below has finished,
		     so nothing loads behind it. -->
		<WebView x:Name="Browser"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated" />

		<!-- Startup check. The app carries HaGeZi's block list itself, so the
		     only question is whether to filter with it. Shown until you choose,
		     and reachable again before every start. -->
		<Grid x:Name="AdGate"
              IsVisible="False"
              BackgroundColor="#101014"
              Padding="56">

			<VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="18">

				<Label Text="Un0Tv"
                       FontSize="52"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

				<Label Text="Ad blocker"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#8FA8D8"
                       HorizontalTextAlignment="Center" />

				<!-- The switch itself: one button whose label and colour show
				     whether filtering is on. -->
				<Button x:Name="BtnBlocker"
                        Clicked="OnBlockerToggled"
                        FontSize="26"
                        FontAttributes="Bold"
                        Padding="44,20"
                        CornerRadius="12"
                        HorizontalOptions="Center"
                        MinimumWidthRequest="380" />

				<Label x:Name="GateStatus"
                       FontSize="20"
                       TextColor="#B8B8CC"
                       HorizontalTextAlignment="Center"
                       MaximumWidthRequest="900" />

				<!-- Downloading shows a moving line; idle keeps it empty so the
				     layout does not jump. -->
				<ProgressBar x:Name="GateProgress"
                             IsVisible="False"
                             ProgressColor="#1F6FEB"
                             WidthRequest="620"
                             HeightRequest="6" />

				<Label x:Name="GateHint"
                       FontSize="16"
                       TextColor="#7A7A90"
                       HorizontalTextAlignment="Center"
                       MaximumWidthRequest="900" />

				<Button x:Name="BtnStart"
                        Text="Start watching"
                        Clicked="OnStartClicked"
                        BackgroundColor="#1F6FEB"
                        TextColor="White"
                        FontSize="23"
                        Padding="40,18"
                        CornerRadius="12"
                        HorizontalOptions="Center"
                        Margin="0,14,0,0" />

				<Button x:Name="BtnUpdate"
                        Text="Update the list"
                        Clicked="OnUpdateClicked"
                        BackgroundColor="#2A2A38"
                        TextColor="#C8C8D8"
                        FontSize="18"
                        Padding="22,12"
                        CornerRadius="10"
                        HorizontalOptions="Center" />

			</VerticalStackLayout>
		</Grid>
	</Grid>
</ContentPage>
