<?xml version="1.0" encoding="utf-8"?>
<!-- A row's secondary text (a history row's URL and time): dim at rest, lighter on the focused row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/text_secondary" />
    <item android:color="@color/text_dim" />
</selector>
