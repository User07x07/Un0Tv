<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog list rows. A ListView row is "selected" under the D-pad (the list keeps focus); a
     TrackSelectionView row is focused itself. Either way it turns white on the row-focus fill,
     as does the checked row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="@color/on_surface" />
    <item android:state_focused="true" android:color="@color/on_surface" />
    <item android:state_pressed="true" android:color="@color/on_surface" />
    <item android:state_checked="true" android:color="@color/on_surface" />
    <item android:color="@color/bar_icon" />
</selector>
