<?xml version="1.0" encoding="utf-8"?>
<!-- A history row, the same surface as a settings row; focused, the row-focus fill and outline,
     with the texts lightening through duplicateParentState. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/row_bg"
    android:paddingStart="10dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:focusable="true">

    <TextView
        android:id="@+id/rowLetter"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/letter_tile_small_bg"
        android:gravity="center"
        android:text="M"
        android:textColor="@color/on_focus_fill"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:duplicateParentState="true"
            android:text="@string/app_name"
            android:textColor="@color/row_primary_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rowUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:duplicateParentState="true"
            android:text="@string/url_hint"
            android:textColor="@color/row_secondary_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:duplicateParentState="true"
        android:fontFeatureSettings="tnum"
        android:text="@string/history"
        android:textColor="@color/row_secondary_text"
        android:textSize="13sp" />
</LinearLayout>
