<?xml version="1.0" encoding="utf-8"?>
<!-- A favorite card: the card surface and a hairline; focused, a 3dp white ring (HomeView adds
     the lift and scale). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/card_surface" />
            <stroke android:width="3dp" android:color="@color/focus_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/card_surface" />
            <stroke android:width="1dp" android:color="@color/hairline_soft" />
        </shape>
    </item>
</selector>
