<?xml version="1.0" encoding="utf-8"?>
<!-- The capsule bar's address pill: the warm control fill every text field uses, a step lighter
     with the accent ring while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/field_focused" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/control" />
        </shape>
    </item>
</selector>
