<?xml version="1.0" encoding="utf-8"?>
<!-- A settings / history row: the card surface and a hairline at rest; focused, the row-focus
     fill with a soft white outline (never a white fill). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/row_focused" />
            <stroke android:width="2dp" android:color="@color/row_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/card_surface" />
            <stroke android:width="1dp" android:color="@color/hairline_soft" />
        </shape>
    </item>
</selector>
