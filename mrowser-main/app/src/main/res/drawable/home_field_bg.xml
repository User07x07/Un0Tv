<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's address pill: the control fill and a hairline; focused, a step lighter
     with the accent ring, like every text field. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/field_focused" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/control" />
            <stroke android:width="1dp" android:color="@color/hairline_soft" />
        </shape>
    </item>
</selector>
