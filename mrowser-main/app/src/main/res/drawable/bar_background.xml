<?xml version="1.0" encoding="utf-8"?>
<!-- The floating capsule behind the address bar. A touch more opaque than the design's
     frosted glass: Android cannot blur what is behind a view before API 31. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="30dp" />
    <solid android:color="@color/capsule" />
    <stroke android:width="1dp" android:color="@color/hairline" />
</shape>
